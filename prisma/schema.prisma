generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  forms         Form[]
  automations   Automation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Form {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalUrl   String
  googleFormId  String
  title         String
  description   String?
  structure     Json     
  isRequiresAuth Boolean @default(false)
  lastFetchedAt DateTime @default(now())
  automations   Automation[]
  @@unique([userId, googleFormId])
}

model Automation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formId          String
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  name            String
  isActive        Boolean  @default(true)
  cronExpression  String   
  timezone        String   
  useFallback     Boolean  @default(false)
  maxFallbackDays Int      @default(7)
  status          String   @default("ACTIVE") 
  answers         AutomationAnswer[]
  executions      ExecutionLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AutomationAnswer {
  id             String     @id @default(cuid())
  automationId   String
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  questionId     String     
  questionType   String     
  value          Json       
}

model ExecutionLog {
  id             String     @id @default(cuid())
  automationId   String
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status         String     
  errorReason    String?
  usedFallback   Boolean    @default(false)
  durationMs     Int?
  scheduledFor   DateTime
  executedAt     DateTime   @default(now())
}